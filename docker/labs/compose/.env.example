# Copy this to .env before running 05-final.yaml:
#
#     cp .env.example .env
#
# Compose reads .env automatically and substitutes ${VAR} in the compose file.
#
# .env is in .gitignore and .dockerignore. .env.example is committed -- it
# documents which variables exist without leaking their values. That pairing is
# the convention; follow it on real projects.
#
# Check what Compose actually resolved:
#     docker compose -f 05-final.yaml config

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-real-life
POSTGRES_DB=app

# Host port for nginx. Change it if 8080 is already taken on your machine.
HTTP_PORT=8080
